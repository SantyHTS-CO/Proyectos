{
  // =================================================================
  // appsettings.json — Configuración de la app
  // -----------------------------------------------------------------
  // NUNCA subas a Git contraseñas ni llaves de Google.
  // En desarrollo usa "User Secrets" (clic derecho al proyecto >
  // Manage User Secrets) y en servidor, variables de entorno.
  // =================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // -------- Conexión a BigQuery --------
  "ConnectionStrings": {
    // BigQuery por ODBC. "BQCOL" es el DSN de 64 bits configurado en
    // "Orígenes de datos ODBC (64 bits)". El DSN define el proyecto de
    // facturación (Catalog) y la autenticación.
    // Alternativa sin DSN, con service account (para el servidor):
    // "Driver={Simba ODBC Driver for Google BigQuery};Catalog=mi-proyecto;SQLDialect=1;OAuthMechanism=0;Email=sa@mi-proyecto.iam.gserviceaccount.com;KeyFilePath=C:\\llaves\\sa.json;"
    "BigQueryOdbc": "DSN=BQCOL"
  },

  // -------- Horas que dura la caché de cada informe --------
  "CacheHoras": 12,

  // -------- Informes (cada uno es una tarjeta en la portada) --------
  // Consulta: archivo "Consultas/x.bqsql" (recomendado) o SQL en una línea.
  //           Si el SQL tiene "?", se llena con la fecha de hoy.
  // Marca:    "yoigo" (Yoigo · MásMóvil, morado) u "orange" (naranja). Pone
  //           los colores del informe según la guía de estilos.
  // ConsultaMotivo: si se pone, el informe tiene la pestaña «Motivo».
  "Informes": [
    {
      "Id": "bo-tiendas",
      "Titulo": "BO Tiendas",
      "Descripcion": "Tickets Edison Shop por agente, team y día",
      "Pie": "Tickets + nómina",
      "Marca": "yoigo",
      "Fuente": "BigQuery",
      "Consulta": "Consultas/bo_tiendas.bqsql",
      "ConsultaMotivo": "Consultas/bo_tiendas_motivo.bqsql",
      "Habilitado": true
    }
  ]
}
