@* =====================================================================
   Views/Informes/Motivo.cshtml — Pestaña «Motivo» (BO Tiendas)
   ---------------------------------------------------------------------
   Llamadas de la línea del ticket en los 3 días siguientes y si su motivo
   es el mismo o diferente: 5 tarjetas, ranking (por motivo, agente o team)
   y el tipo de motivo en el tiempo. Misma estructura que Tickets (guía de
   estilos 4): panel de filtros a la izquierda y contenido a la derecha.
   Solo marcado: los cálculos están en Services/TableroMotivo.fs.
   ===================================================================== *@
@model MotivoViewModel
@{
    ViewData["Title"] = Model.Config.Titulo;
    ViewData["Subtitulo"] = "Motivo de las llamadas en los 3 días siguientes al ticket";
    ViewData["Marca"] = Model.Config.Marca;
    var f = Model.Filtros;
}

<partial name="_Pestanas" model="Model.Pagina" />

@if (Model.Error is not null)
{
    <div class="tablero sin-panel">
        <section class="contenido">
            <div class="aviso aviso-error" role="alert">
                @Iconos.Alerta
                <p><strong>No se pudo cargar el informe.</strong><br />@Model.Error</p>
            </div>
        </section>
    </div>
}
else
{
    <div class="tablero">

        @* ---------------- Panel de filtros ---------------- *@
        <form id="filtros" class="panel-filtros" method="get" asp-action="Motivo" asp-route-id="@Model.Config.Id" data-filtros>
            @* Valores que cambian los botones [data-fijar]. Lo vacío o igual
               a data-defecto no se escribe en la URL. *@
            <input type="hidden" name="Ver" value="@f.Ver" data-defecto="motivo2" />
            <input type="hidden" name="TipoMotivo" value="@f.TipoMotivo" />
            <input type="hidden" name="PeriodoMotivo" value="@f.PeriodoMotivo" data-defecto="semana" />

            <h2 class="panel-titulo">Filtros</h2>

            <div class="campo">
                <span class="campo-nombre">Fecha del ticket</span>
                <div class="rango-fechas">
                    <label for="f-Desde">Desde</label>
                    <input type="date" id="f-Desde" name="Desde" value="@f.Desde?.ToString("yyyy-MM-dd")"
                           min="@Model.FechaMin.ToString("yyyy-MM-dd")" max="@Model.FechaMax.ToString("yyyy-MM-dd")"
                           data-defecto="@Model.FechaMin.ToString("yyyy-MM-dd")" />
                    <label for="f-Hasta">Hasta</label>
                    <input type="date" id="f-Hasta" name="Hasta" value="@f.Hasta?.ToString("yyyy-MM-dd")"
                           min="@Model.FechaMin.ToString("yyyy-MM-dd")" max="@Model.FechaMax.ToString("yyyy-MM-dd")"
                           data-defecto="@Model.FechaMax.ToString("yyyy-MM-dd")" />
                </div>
            </div>

            @foreach (var lista in Model.Listas)
            {
                <partial name="_Lista" model="lista" />
            }

            @* Mismo / Diferente motivo: clic = filtrar; clic otra vez = quitar *@
            <div class="campo">
                <span class="campo-nombre">Tipo de motivo</span>
                <div class="segmento lleno" role="group" aria-label="Tipo de motivo">
                    @foreach (var (valor, texto) in new[] { ("Mismo motivo", "Mismo"), ("Diferente motivo", "Diferente") })
                    {
                        var activo = valor == f.TipoMotivo;
                        <button type="button" class="@(activo ? "activo" : null)" aria-pressed="@(activo ? "true" : "false")"
                                data-fijar="TipoMotivo" data-valor="@(activo ? "" : valor)">@texto</button>
                    }
                </div>
            </div>

            @if (Model.MasListas.Length > 0)
            {
                <details class="mas-filtros" open="@(Model.MasFiltrosActivos > 0)">
                    <summary>
                        Más filtros
                        @if (Model.MasFiltrosActivos > 0)
                        {
                            <span class="contador" aria-label="@Model.MasFiltrosActivos activos">@Model.MasFiltrosActivos</span>
                        }
                    </summary>
                    <div class="mas-filtros-cuerpo">
                        @foreach (var lista in Model.MasListas)
                        {
                            <partial name="_Lista" model="lista" />
                        }
                    </div>
                </details>
            }

            <div class="panel-acciones">
                <a class="boton boton-secundario" asp-action="Motivo" asp-route-id="@Model.Config.Id" data-filtrar>Limpiar filtros</a>
                <a class="boton" href="@(Url.Action("DescargarMotivo", new { id = Model.Config.Id }) + Context.Request.QueryString)" data-sin-carga>
                    @Iconos.Descarga<span>Descarga general</span>
                </a>
            </div>
        </form>

        @* ---------------- Contenido ---------------- *@
        <section class="contenido">
            @if (Model.SinAgente > 0)
            {
                <div class="aviso aviso-info">
                    @Iconos.Info
                    <p>@Formato.Entero(Model.SinAgente) llamadas son de tickets que no cruzan con la nómina (sin agente) y no se incluyen.</p>
                </div>
            }
            @if (Model.VentanaAbierta)
            {
                <div class="aviso aviso-info">
                    @Iconos.Reloj
                    <p>El rango incluye tickets de los 3 últimos días: aún pueden recibir llamadas, así que sus cifras todavía pueden subir.</p>
                </div>
            }

            @if (!Model.HayDatos)
            {
                <div class="tarjeta aparece"><p class="nota">No hay llamadas con estos filtros.</p></div>
            }
            else
            {
                @* ---------------- Tira de 5 tarjetas ---------------- *@
                <p class="nota nota-comparacion">
                    @if (Model.HayPeriodoAnterior)
                    {
                        <text>Comparado con el periodo anterior: <strong>@Model.PeriodoAnterior</strong></text>
                    }
                    else
                    {
                        <text>Sin datos del periodo anterior (@Model.PeriodoAnterior) para comparar: elige un rango de fechas más corto.</text>
                    }
                </p>

                <div class="resumen de-5">
                    @foreach (var t in Model.Indicadores)
                    {
                        var ind = t.Indicador;
                        <div class="resumen-dato aparece @(t.Destacada ? "destacada" : null)">
                            <span class="dato-cabeza">
                                <span class="dato-icono">@t.Icono</span>
                                <span class="dato-nombre">@t.Nombre</span>
                            </span>
                            <strong class="dato-cifra" data-cifra="@ind.TipoCifra" data-valor="@ind.Crudo" data-clave="@t.Nombre">@ind.Valor</strong>
                            @if (t.Detalle is not null)
                            {
                                <span class="dato-detalle">@t.Detalle</span>
                            }
                            @if (ind.Cambio is not null)
                            {
                                <span class="dato-cambio @ind.Tono" title="Periodo anterior: @ind.Anterior">@ind.Cambio <small>vs anterior</small></span>
                            }
                            else
                            {
                                <span class="dato-cambio neutro">sin comparación</span>
                            }
                        </div>
                    }
                </div>

                @* ---------------- Ranking ----------------
                   «Ver por» cambia las filas; pulsar un encabezado ordena. *@
                <section class="tarjeta aparece" id="ranking">
                    <div class="tarjeta-cabeza">
                        <h2>Ranking</h2>
                        <div class="segmento" role="group" aria-label="Ver por">
                            @foreach (var (valor, texto) in new[] { ("motivo2", "Motivo 2"), ("motivo3", "Motivo 3"), ("agente", "Agente"), ("team", "Team") })
                            {
                                var activo = f.Ver == valor;
                                <button type="button" class="@(activo ? "activo" : null)" aria-pressed="@(activo ? "true" : "false")"
                                        data-fijar="Ver" data-valor="@valor" data-ancla="ranking">@texto</button>
                            }
                        </div>
                    </div>
                    <partial name="_Ranking" model="Model.Ranking" />
                </section>

                @* ---------------- Tipo de motivo en el tiempo ---------------- *@
                <section class="tarjeta crono-tarjeta aparece" id="motivos">
                    <div class="tarjeta-cabeza">
                        <h2>Tipo de motivo en el tiempo</h2>
                        <div class="segmento" role="group" aria-label="Ver por">
                            @foreach (var (valor, texto) in new[] { ("semana", "Semana"), ("mes", "Mes"), ("dia", "Día") })
                            {
                                var activo = f.PeriodoMotivo == valor;
                                <button type="button" class="@(activo ? "activo" : null)" aria-pressed="@(activo ? "true" : "false")"
                                        data-fijar="PeriodoMotivo" data-valor="@valor" data-ancla="motivos">@texto</button>
                            }
                        </div>
                    </div>
                    <partial name="_GraficaLineas" model="Model.Motivos" />
                </section>

                <p class="nota">
                    <strong>Cómo se cuenta.</strong> Tickets: los del periodo en la pestaña Tickets, con los mismos
                    filtros. Tickets que volvieron a llamar: los que tienen al menos una llamada entrante de su línea
                    entre el día del ticket y los 3 días siguientes. Llamadas: esas llamadas, contadas una vez cada una.
                    Mismo motivo: el motivo de la llamada está en el catálogo de la consulta; el resto es diferente motivo.
                </p>
            }
        </section>
    </div>
}
