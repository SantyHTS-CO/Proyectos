@* =====================================================================
   Views/Shared/_Ranking.cshtml — Tabla de ranking (guía de estilos 5)
   ---------------------------------------------------------------------
   table.ranking[data-mapa]: site.js ordena al pulsar un encabezado,
   pinta el semáforo pastel según th[data-sentido] (1 más es mejor, −1
   más es peor, 0 sin color), la intensidad del acento en th[data-calor="si"]
   y pagina de 10 en 10. Las filas .pocas (menos de 20 llamadas) van
   al final y en gris; la fila de totales, sin color.
   Pulsar una fila filtra el informe por ella (Model.Filtro = el parámetro
   de la URL); si ya es la elegida, quita el filtro. Las filas sin clave
   («(sin dato)») no se pueden filtrar. Ojo: Razor escribe siempre los
   data-*, así que site.js ignora el data-fijar vacío.
   ===================================================================== *@
@model Ranking
@{
    var hayElegida = Array.Exists(Model.Filas, fila => fila.Elegida);
}

<div class="tabla-scroll">
    <table class="ranking @(hayElegida ? "con-seleccion" : null)" data-mapa data-paginar="10">
        <thead>
            <tr>
                <th class="izq" scope="col" data-orden="texto">@Model.Agrupacion</th>
                @foreach (var c in Model.Columnas)
                {
                    @* Ojo: Razor siempre escribe los data-*, aunque valgan null: por eso calor = si | no *@
                    <th scope="col" data-orden="@c.Orden" data-sentido="@c.Sentido" data-calor="@(c.Calor ? "si" : "no")">@c.Titulo</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in Model.Filas)
            {
                var elegible = fila.Clave is not null;
                var ayuda = !elegible ? null : fila.Elegida ? "Pulsa para quitar el filtro" : "Pulsa para filtrar por esta fila";
                <tr class="@(fila.Pocas ? "pocas" : null) @(elegible ? "elegible" : null) @(fila.Elegida ? "elegida" : null)"
                    title="@(fila.Pocas ? "Menos de 20 llamadas: va al final y sin color. " + ayuda : ayuda)"
                    data-fijar="@(elegible ? Model.Filtro : null)" data-valor="@(fila.Elegida ? "" : fila.Clave)"
                    tabindex="@(elegible ? "0" : null)">
                    <td class="izq nombre">
                        @fila.Nombre
                        @if (fila.Detalle is not null)
                        {
                            <span class="sub">@fila.Detalle</span>
                        }
                    </td>
                    @foreach (var celda in fila.Celdas)
                    {
                        <td data-valor="@celda.Valor">
                            @if (celda.Clase is null)
                            {
                                @celda.Texto
                            }
                            else
                            {
                                <span class="chip @celda.Clase">@celda.Texto</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td class="izq">Total</td>
                @foreach (var celda in Model.Total)
                {
                    <td>@celda.Texto</td>
                }
            </tr>
        </tfoot>
    </table>
</div>
